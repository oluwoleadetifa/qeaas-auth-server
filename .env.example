# QEaaS local configuration template.
# Copy to .env only for local experiments. Do not commit real .env files.

# Authenticated QEaaS service bind address.
AUTH_ADDR=127.0.0.1:3000

# QRNG service node endpoint.
QRNG_BASE_URL=http://127.0.0.1:8080

# Supported values: direct_qrng, hybrid_csprng, parallel_hybrid.
# hybrid_pool is accepted as an alias for parallel_hybrid.
ENTROPY_MODE=direct_qrng

# Hybrid entropy settings.
HYBRID_QRNG_SEED_SIZE=32
HYBRID_RESEED_AFTER_BYTES=1048576
HYBRID_POOL_SIZE=8

# Optional request-stage timing JSONL on stdout.
ENABLE_STAGE_TIMING=0
